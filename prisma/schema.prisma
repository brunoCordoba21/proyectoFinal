generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  GUIA
  CLIENTE
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   @default("123456")
  nombre    String
  rol       Rol      @default(CLIENTE)
  createdAt DateTime @default(now())

  guia      Guia?
  cliente   Cliente?
}

model Guia {
  id           Int       @id @default(autoincrement())
  telefono     String
  modalidades  String?
  embarcacion  String?
  servicios    String?
  precioBase   Float
  precioFull   Float?
  capacidadMax Int       @default(3)

  usuarioId    Int       @unique
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  reservas     Reserva[]
}

model Cliente {
  id        Int       @id @default(autoincrement())
  telefono  String?

  usuarioId Int       @unique
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  reservas  Reserva[]
}

model Reserva {
  id             Int      @id @default(autoincrement())
  fechaExcursion DateTime
  cantPersonas   Int
  tipoServicio   String
  precioTotal    Float
  estado         String   @default("PENDIENTE")

  guiaId         Int
  guia           Guia     @relation(fields: [guiaId], references: [id])

  clienteId      Int
  cliente        Cliente  @relation(fields: [clienteId], references: [id])

  createdAt      DateTime @default(now())
}